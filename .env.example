# Copy to .env and adjust. Never commit the real .env.

# --- database ---
POSTGRES_DB=vehicle_tracking
POSTGRES_USER=vehicle_tracking
POSTGRES_PASSWORD=change-me

# --- host ports (change if something else already listens on them) ---
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- collection ---
FEED_VEHICLE_POSITIONS_URL=https://api.entur.io/realtime/v1/gtfs-rt/vehicle-positions
FEED_POLL_INTERVAL=00:00:03
# Entur asks every client to identify itself in the ET-Client-Name header.
FEED_CLIENT_NAME=your-org-vehicle-tracking

# Service alerts change slowly, so they are read far less often than vehicle positions.
ALERTS_URL=https://api.entur.io/realtime/v1/gtfs-rt/alerts
ALERTS_POLL_INTERVAL=00:00:30

# Trip updates (delays per stop) are ~12 MB per read, so keep this interval modest.
TRIP_UPDATES_URL=https://api.entur.io/realtime/v1/gtfs-rt/trip-updates
TRIP_UPDATES_POLL_INTERVAL=00:00:30

# --- retention ---
# Set to e.g. 00:05:00 to watch old data being dropped without waiting 3 hours.
RETENTION_PERIOD=03:00:00

# --- authentication ---
# HS256 key for access tokens, at least 32 characters (for example: openssl rand -base64 48).
# Leave empty to generate a random one at every start; everyone then signs in again after a restart.
AUTH_SIGNING_KEY=
# The admin account is created at startup if it does not exist. Change the password outside local development.
AUTH_ADMIN_EMAIL=admin@vehicle-tracking.local
AUTH_ADMIN_PASSWORD=admin12345
# Set to true when the site is served over https (marks the refresh cookie Secure).
AUTH_COOKIE_SECURE=false
