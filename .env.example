# Copy to .env and adjust. Never commit the real .env.

# --- database ---
POSTGRES_DB=vehicle_tracking
POSTGRES_USER=vehicle_tracking
POSTGRES_PASSWORD=change-me

# --- host ports (change if something else already listens on them) ---
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- collection ---
FEED_VEHICLE_POSITIONS_URL=https://api.entur.io/realtime/v1/gtfs-rt/vehicle-positions
FEED_POLL_INTERVAL=00:00:03
# Entur asks every client to identify itself in the ET-Client-Name header.
FEED_CLIENT_NAME=your-org-vehicle-tracking

# --- retention ---
# Set to e.g. 00:05:00 to watch old data being dropped without waiting 3 hours.
RETENTION_PERIOD=03:00:00
