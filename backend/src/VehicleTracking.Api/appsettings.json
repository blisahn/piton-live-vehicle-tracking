{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Feed": {
    "VehiclePositionsUrl": "https://api.entur.io/realtime/v1/gtfs-rt/vehicle-positions",
    "PollInterval": "00:00:03",
    "ClientName": "vehicle-tracking-case-study"
  },
  "Alerts": {
    "Url": "https://api.entur.io/realtime/v1/gtfs-rt/alerts",
    "PollInterval": "00:00:30"
  },
  "TripUpdates": {
    "Url": "https://api.entur.io/realtime/v1/gtfs-rt/trip-updates",
    "PollInterval": "00:00:30"
  },
  "JourneyPlanner": {
    "Url": "https://api.entur.io/journey-planner/v3/graphql"
  },
  "Live": {
    "StaleAfter": "00:10:00"
  },
  "Retention": {
    "Period": "03:00:00"
  },
  "Auth": {
    "Issuer": "vehicle-tracking",
    "Audience": "vehicle-tracking-web",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "CookieSecure": false,
    "AdminEmail": "admin@vehicle-tracking.local",
    "AdminPassword": "admin12345"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Spool": {
    "Directory": "spool"
  }
}
